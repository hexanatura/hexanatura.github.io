{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:rules": "cd .. && firebase emulators:exec --project demo-security-audit --only firestore,storage \"npm --prefix functions run test:rules:unit\"",
    "test:rules:unit": "node --test test/rules.test.js test/promo-reservations.test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.5.0",
    "razorpay": "^2.9.8"
  },
  "private": true,
  "overrides": {
    "@firebase/app": "0.16.6",
    "@firebase/app-compat": "0.5.22",
    "@grpc/grpc-js": "^1.14.7",
    "rimraf": "^6.1.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
