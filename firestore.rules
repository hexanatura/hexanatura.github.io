rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true;
    }

    // Promo Codes
    match /promoCodes/{promoId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Contact Submissions
    match /contactSubmissions/{id} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Publicly visible career openings; all job management is admin-only.
    match /careerOpenings/{openingId} {
      allow read: if isAdmin() || resource.data.status == 'open';
      allow create, update, delete: if isAdmin();
    }

    // Applications are private; public submissions are accepted only by Cloud Functions.
    match /careerApplications/{applicationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Rate-limit records are managed only by Cloud Functions.
    match /careerApplicationLimits/{limitId} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow create: if isAuth() && isOwner(userId);
      allow read: if isAdmin() || isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'address', 'updatedAt', 'lastLoginAt', 'preferences'
        ]));
      allow delete: if isAdmin();

      // User Orders
      match /orders/{orderId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create: if false;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // User Addresses
      match /addresses/{addressId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll([
            'label', 'name', 'address', 'phone', 'pincode', 'city', 'state', 'country', 'createdAt', 'isDefault'
          ]);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'label', 'name', 'address', 'phone', 'pincode', 'city', 'state', 'country', 'updatedAt', 'isDefault'
          ]);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Temporary Orders (Guest Checkout) - UPDATED
    match /tempOrders/{tempOrderId} {
      allow read, write: if false;
    }

    // Global orders contain customer and payment data; access is server-managed.
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /orderTrackingLimits/{limitId} {
      allow read, write: if false;
    }

    match /reviewSubmissionLimits/{limitId} {
      allow read, write: if false;
    }

    // Allow administrators to query orders across all user subcollections.
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    // Admin Accounts
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Activity Log
    match /activities/{activityId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if settingId == 'storefront' || isAdmin();
      allow write: if isAdmin();
    }
  }
}
